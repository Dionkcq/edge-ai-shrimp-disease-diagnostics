views {
  view index {
    title '01 · System context — offline screening, external confirmation'
    description '''
The product reports visible appearances from one photograph. Laboratory confirmation
and professional interpretation remain explicitly outside the system boundary.
No relationship from the screening system reaches an internet service.
'''
    include operator, screeningSystem, healthProfessional, laboratory
    include operator -> screeningSystem.webUi
    include screeningSystem.webUi -> healthProfessional
    include healthProfessional -> laboratory
  }

  view containers of screeningSystem {
    title '02 · Runtime containers — one local origin'
    description '''
The browser UI and FastAPI service communicate only over the local network. Policies,
guidance and model metadata are versioned local files. The ONNX artifact is optional
and absent on a clean checkout.
'''
    include webUi, api, qualityPolicy, decisionPolicyFile, guidanceStore, modelRegistry, onnxArtifact
    include webUi -> api
    include qualityPolicy -> api.qualityGate
    include decisionPolicyFile -> api.decisionPolicy
    include guidanceStore -> api.guidance
    include modelRegistry -> api.provider
    include onnxArtifact -> api.provider
  }

  view screeningComponents of screeningSystem.api {
    title '03 · Screening API — key components and safety controls'
    description '''
Untrusted bytes move through bounded intake and deterministic quality checks before
any optional inference. Named marker roles—not class indices—drive a five-state
policy. The response always carries limitations and model provenance.
'''
    include *
    include * -> *
  }

  dynamic view screeningSequence {
    title '04 · Screening sequence — one photograph end to end'
    description '''
The common path and every early exit are explicit. Encoded bytes and pixels are
request-scoped; no image, filename or EXIF metadata is persisted.
'''
    operator -> screeningSystem.webUi 'selects original photograph'
    screeningSystem.webUi -> screeningSystem.api.requestBoundary 'POST /api/v1/screenings'
    screeningSystem.api.requestBoundary -> screeningSystem.api.imageIntake 'bounded image bytes'
    screeningSystem.api.imageIntake -> screeningSystem.api.qualityGate 'EXIF-corrected RGB pixels'
    alt {
      when 'quality FAIL' {
        screeningSystem.api.qualityGate -> screeningSystem.api.decisionPolicy 'IMAGE_QUALITY_REJECTED'
      }
      else 'quality PASS' {
        alt {
          when 'model unavailable' {
            screeningSystem.api.provider -> screeningSystem.api.decisionPolicy 'MODEL_UNAVAILABLE'
          }
          else 'model available' {
            screeningSystem.api.provider -> screeningSystem.api.inferenceGate 'request inference slot'
            screeningSystem.api.inferenceGate -> screeningSystem.api.postprocess 'candidate detections'
            screeningSystem.api.postprocess -> screeningSystem.api.decisionPolicy 'named roles + normalized boxes'
          }
        }
      }
    }
    screeningSystem.api.decisionPolicy -> screeningSystem.api.guidance 'decision key'
    screeningSystem.api.decisionPolicy -> screeningSystem.api.contract 'decision + optional abstention reason'
    screeningSystem.api.guidance -> screeningSystem.api.contract 'citation reference'
    screeningSystem.api.contract -> screeningSystem.webUi 'ScreeningResult 1.0.0'
    screeningSystem.webUi -> operator 'result, notices, limitations and retake/escalation guidance'
  }

  view securityBoundary {
    title '05 · Security and trust boundaries — local, bounded, ephemeral'
    description '''
The phone and image are untrusted. The request boundary limits bytes before decode;
image intake validates format and dimensions; the quality gate blocks unsuitable
input. Runtime data stays on the isolated LAN and in process memory. Guidance and
policies are reviewed local content, not network responses.
'''
    include operator, screeningSystem.webUi, screeningSystem.api.requestBoundary, screeningSystem.api.imageIntake, screeningSystem.api.qualityGate, screeningSystem.api.inferenceGate, screeningSystem.api.contract, screeningSystem.qualityPolicy, screeningSystem.decisionPolicyFile, screeningSystem.guidanceStore
    include operator -> screeningSystem.webUi
    include screeningSystem.webUi -> screeningSystem.api.requestBoundary
    include screeningSystem.api.requestBoundary -> screeningSystem.api.imageIntake
    include screeningSystem.api.imageIntake -> screeningSystem.api.qualityGate
    include screeningSystem.api.inferenceGate -> screeningSystem.api.contract
    include screeningSystem.qualityPolicy -> screeningSystem.api.qualityGate
    include screeningSystem.guidanceStore -> screeningSystem.api.contract
  }

  view decisionBoundary {
    title '06 · Decision and abstention — fail closed, never diagnose'
    description '''
Exactly five screening decisions exist. `UNABLE_TO_ASSESS` absorbs quality rejection,
missing capability, weak evidence and inference failure. A negative marker result is
not evidence of health and always carries that limitation.
'''
    include screeningSystem.api.qualityGate, screeningSystem.api.provider, screeningSystem.api.postprocess, screeningSystem.api.decisionPolicy, screeningSystem.api.contract, screeningSystem.decisionPolicyFile
    include screeningSystem.api.qualityGate -> screeningSystem.api.decisionPolicy
    include screeningSystem.api.provider -> screeningSystem.api.decisionPolicy
    include screeningSystem.api.postprocess -> screeningSystem.api.decisionPolicy
    include screeningSystem.decisionPolicyFile -> screeningSystem.api.decisionPolicy
    include screeningSystem.api.decisionPolicy -> screeningSystem.api.contract
  }

  dynamic view abstentionFlow {
    title '07 · Abstention flow — why the service declines'
    description '''
This sequence isolates the product\'s fail-closed thesis. None of these branches may
fall through to `NO_TARGET_MARKER_DETECTED`.
'''
    screeningSystem.api.qualityGate -> screeningSystem.api.decisionPolicy 'FAIL → IMAGE_QUALITY_REJECTED'
    screeningSystem.api.provider -> screeningSystem.api.decisionPolicy 'not installed → MODEL_UNAVAILABLE'
    screeningSystem.api.postprocess -> screeningSystem.api.decisionPolicy 'weak recognised sighting → LOW_CONFIDENCE'
    screeningSystem.api.provider -> screeningSystem.api.decisionPolicy 'runtime error → INFERENCE_FAILED'
    screeningSystem.api.decisionPolicy -> screeningSystem.api.contract 'UNABLE_TO_ASSESS + one reason'
    screeningSystem.api.contract -> screeningSystem.webUi 'notices, limitation IDs and corrective guidance'
  }

  view dataTrainingBoundary {
    title '08 · Data and training boundary — development only'
    description '''
Source data and AGPL-governed training tooling never enter the served runtime. Two
human gates acknowledge the provisional class mapping and annotation-convention
drift. A candidate artifact crosses the boundary only with registry metadata and
evaluation evidence. No completed training run or model artifact is claimed.
'''
    include trainingBoundary, trainingBoundary.*, screeningSystem.onnxArtifact, screeningSystem.modelRegistry
    include trainingBoundary.* -> trainingBoundary.*
    include trainingBoundary.evaluation -> screeningSystem.onnxArtifact
    include trainingBoundary.evaluation -> screeningSystem.modelRegistry
  }

  deployment view offlineDeployment {
    title '09 · Offline deployment — phone and laptop on an isolated LAN'
    description '''
The phone captures and displays; the laptop serves static UI/API and performs local
processing. The diagram intentionally contains no internet, cloud, telemetry or
remote model endpoint.
'''
    includeAncestors: true
    include field.**
  }

  view publicationBoundary {
    title '10 · Documentation publication boundary'
    description '''
The LikeC4 site is architecture documentation, not the screening application. It is
built from this self-contained directory and published only by manual dispatch after
validation and a scan for private plans, data paths, model files and external runtime
assets.
'''
    include docsSite, screeningSystem, trainingBoundary
  }
}
