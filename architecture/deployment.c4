deployment {
  field = environment 'Field deployment — isolated local network' {
    #offline
    description '''
The laptop creates or joins a local hotspot. The phone reaches the service over the
LAN. No runtime relationship crosses to the internet, and the service has no cloud
inference, analytics or telemetry dependency.
'''

    phone = device 'Operator phone' {
      #offline
      technology 'Mobile browser + camera file capture'
      ui = instanceOf screeningSystem.webUi
    }

    laptop = device 'Edge laptop' {
      #offline
      technology 'Python launcher + local FastAPI process'
      service = process 'Local screening process' {
        technology 'python run.py — one command'
        api = instanceOf screeningSystem.api
        qualityPolicy = instanceOf screeningSystem.qualityPolicy
        decisionPolicy = instanceOf screeningSystem.decisionPolicyFile
        guidance = instanceOf screeningSystem.guidanceStore
        registry = instanceOf screeningSystem.modelRegistry
        launcher = instanceOf screeningSystem.runtimeLauncher
        detector = instanceOf screeningSystem.onnxArtifact {
          title 'Optional validated ONNX bundle — installed out of band'
        }
      }
    }

    phone.ui .local laptop.service.api 'screening request and result over isolated LAN'
  }
}
