# Copy this file to .env in the repository root and uncomment what you need.
# Run uvicorn from the repository root so this file is found (see README.md).
# Every field is optional -- an absent or blank value falls back to the safe
# default described in backend/src/shrimp_screening/settings.py.

# dev | test | demo | production
# "demo" and "production" refuse to start unless SHRIMP_PROVIDER=onnx.
#SHRIMP_ENV=dev

# unavailable | fixture | onnx
# "unavailable" (the default) is the correct state without a trained model.
#SHRIMP_PROVIDER=unavailable

# Path to a validated ONNX artifact. The one-command launcher sets this automatically
# when an official model bundle is placed in ./model/.
#SHRIMP_ONNX_MODEL_PATH=models/shrimp-model-v1.onnx

# Optional generated registry path. Normally this is set automatically by run.py.
#SHRIMP_MODEL_REGISTRY_PATH=.runtime/registry.json

# Request body ceiling in bytes.
#SHRIMP_MAX_UPLOAD_BYTES=12582912

# How many inferences may run at once (single laptop CPU: keep at 1).
#SHRIMP_MAX_CONCURRENT_INFERENCES=1

# Seconds a request may wait to enter the inference slot.
#SHRIMP_QUEUE_WAIT_TIMEOUT_SECONDS=8.0

# Retry-After header value sent on a 503 SERVICE_BUSY response.
#SHRIMP_RETRY_AFTER_SECONDS=2

# --- Optional local advice generation (GET /api/v1/advice/{decision}) ---
# Off by default. Expands the cited guidance in guidance/guidance_v1.json with
# generated phrasing; never used for the screening decision itself. Requires
# a local Ollama server -- never a remote host.
#SHRIMP_LLM_ENABLED=false
#SHRIMP_LLM_BASE_URL=http://127.0.0.1:11434
#SHRIMP_LLM_MODEL=qwen2.5:7b-instruct-q4_0
#SHRIMP_LLM_TIMEOUT_SECONDS=45.0
