{
  "$defs": {
    "AbstentionReason": {
      "description": "Why the system declined, when and only when the decision is UNABLE_TO_ASSESS.",
      "enum": [
        "MODEL_UNAVAILABLE",
        "IMAGE_QUALITY_REJECTED",
        "LOW_CONFIDENCE",
        "INFERENCE_FAILED"
      ],
      "title": "AbstentionReason",
      "type": "string"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Normalized xyxy in the EXIF-corrected *original* image frame.\n\nNormalized, so a client that scales or letterboxes the preview cannot drift from\nthe overlay. Original frame and post-transpose, so a client never has to reason\nabout orientation.",
      "properties": {
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ConfidenceBand": {
      "description": "Discrete bands only.\n\nA percentage would imply a calibrated probability, which no trained model in\nthis repository has ever produced.",
      "enum": [
        "HIGH",
        "MODERATE",
        "LOW",
        "NONE"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "DatasetMappingStatus": {
      "description": "Whether the class-index-to-marker mapping of the training data is confirmed.\n\n``PROVISIONAL_UNCONFIRMED`` ships in every response for as long as the dataset\nauthors have not confirmed the combined-folder class order. It is a\nproduct-visible fact, not a footnote.",
      "enum": [
        "PROVISIONAL_UNCONFIRMED",
        "AUTHOR_CONFIRMED",
        "NOT_APPLICABLE"
      ],
      "title": "DatasetMappingStatus",
      "type": "string"
    },
    "Decision": {
      "description": "The complete set of screening outcomes. There is no sixth member, ever.\n\n``UNABLE_TO_ASSESS`` absorbs quality failure, model unavailability, low\nconfidence and inference failure. The *reason* lives in\n:class:`AbstentionReason` and :class:`QualityReason`, never in the decision,\nso that no caller can pattern-match a decision string into a health claim.",
      "enum": [
        "GILL_DARKENING_MARKER_DETECTED",
        "WHITE_SPOT_MARKER_DETECTED",
        "MULTIPLE_TARGET_MARKERS_DETECTED",
        "NO_TARGET_MARKER_DETECTED",
        "UNABLE_TO_ASSESS"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ImageInfo": {
      "additionalProperties": false,
      "description": "Post-EXIF-transpose facts about the decoded image.\n\nDeliberately excludes every field that could carry personal data: no filename, no\nEXIF block, no GPS, no capture timestamp, no camera make or model.",
      "properties": {
        "exif_transposed": {
          "title": "Exif Transposed",
          "type": "boolean"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "source_mode": {
          "description": "Pillow mode of the file as decoded, before RGB normalization. Echoed so an inverted CMYK conversion is debuggable.",
          "maxLength": 16,
          "minLength": 1,
          "title": "Source Mode",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "source_mode",
        "exif_transposed"
      ],
      "title": "ImageInfo",
      "type": "object"
    },
    "MarkerObservation": {
      "additionalProperties": false,
      "description": "One retained detection.\n\n``class_name`` comes from the model's own metadata; ``role`` comes from the\ndecision policy keyed on that name. No index-to-label table exists anywhere in\nthe backend, so a class-order flip in an exported model changes the labels in the\nresponse instead of silently mislabelling them.",
      "properties": {
        "box": {
          "$ref": "#/$defs/BoundingBox"
        },
        "class_index": {
          "minimum": 0,
          "title": "Class Index",
          "type": "integer"
        },
        "class_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkerRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Screening role assigned by the decision policy, or null if the policy does not recognise this class name."
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "class_index",
        "class_name",
        "score",
        "box"
      ],
      "title": "MarkerObservation",
      "type": "object"
    },
    "MarkerRole": {
      "description": "The screening-relevant meaning of a detected class.\n\nRoles are assigned by *class name* through the decision policy file, never by\nclass index. A class the policy does not name has ``role: null`` and cannot\ninfluence the decision.",
      "enum": [
        "WHITE_SPOT",
        "GILL_DARKENING"
      ],
      "title": "MarkerRole",
      "type": "string"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "class_names": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Class index (as a string key) to class name, read from the model artifact's own metadata. Drives all labelling.",
          "title": "Class Names",
          "type": "object"
        },
        "dataset_mapping_status": {
          "$ref": "#/$defs/DatasetMappingStatus"
        },
        "is_demonstration_data": {
          "description": "True when the numbers in this response were synthesised for demonstration and are not a real model result.",
          "title": "Is Demonstration Data",
          "type": "boolean"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "output_layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "available",
        "provider",
        "dataset_mapping_status",
        "is_demonstration_data"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "NoticeCode": {
      "description": "Response-level facts a user interface must surface, not hide.",
      "enum": [
        "MODEL_NOT_INSTALLED",
        "DEMONSTRATION_DATA_NOT_A_REAL_RESULT",
        "DATASET_CLASS_MAPPING_UNCONFIRMED",
        "THRESHOLDS_UNCALIBRATED"
      ],
      "title": "NoticeCode",
      "type": "string"
    },
    "OutputLayout": {
      "description": "ONNX output contract. The backend depends on this, not on any trainer.",
      "enum": [
        "ultralytics_v8_detect_v1"
      ],
      "title": "OutputLayout",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "onnx",
        "fixture",
        "unavailable"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "QualityMetrics": {
      "additionalProperties": false,
      "description": "Raw measurements, echoed so a retake instruction is auditable.",
      "properties": {
        "blur_score": {
          "description": "Variance of the Laplacian response.",
          "minimum": 0.0,
          "title": "Blur Score",
          "type": "number"
        },
        "mean_luminance": {
          "maximum": 255.0,
          "minimum": 0.0,
          "title": "Mean Luminance",
          "type": "number"
        },
        "min_side_px": {
          "minimum": 1,
          "title": "Min Side Px",
          "type": "integer"
        },
        "rms_contrast": {
          "minimum": 0.0,
          "title": "Rms Contrast",
          "type": "number"
        }
      },
      "required": [
        "blur_score",
        "mean_luminance",
        "rms_contrast",
        "min_side_px"
      ],
      "title": "QualityMetrics",
      "type": "object"
    },
    "QualityReason": {
      "description": "Retake instructions. Each maps to one corrective action a person can take.",
      "enum": [
        "IMAGE_TOO_SMALL",
        "IMAGE_TOO_BLURRY",
        "IMAGE_TOO_DARK",
        "IMAGE_TOO_BRIGHT",
        "IMAGE_LOW_CONTRAST"
      ],
      "title": "QualityReason",
      "type": "string"
    },
    "QualityReport": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/$defs/QualityMetrics"
        },
        "policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/QualityReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QualityStatus"
        }
      },
      "required": [
        "status",
        "metrics",
        "policy_id",
        "policy_hash"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "Timings": {
      "additionalProperties": false,
      "properties": {
        "inference_ms": {
          "minimum": 0.0,
          "title": "Inference Ms",
          "type": "number"
        },
        "intake_ms": {
          "minimum": 0.0,
          "title": "Intake Ms",
          "type": "number"
        },
        "quality_ms": {
          "minimum": 0.0,
          "title": "Quality Ms",
          "type": "number"
        },
        "total_ms": {
          "minimum": 0.0,
          "title": "Total Ms",
          "type": "number"
        }
      },
      "required": [
        "intake_ms",
        "quality_ms",
        "inference_ms",
        "total_ms"
      ],
      "title": "Timings",
      "type": "object"
    }
  },
  "$id": "https://shrimp-screening.invalid/schemas/screening_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response body of POST /api/v1/screenings. Generated from backend/src/shrimp_screening/contracts/screening.py; do not hand-edit.",
  "properties": {
    "abstention_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbstentionReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence_band": {
      "$ref": "#/$defs/ConfidenceBand"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "guidance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Guidance Refs",
      "type": "array"
    },
    "image": {
      "$ref": "#/$defs/ImageInfo"
    },
    "limitations": {
      "description": "Identifiers defined in docs/LIMITATIONS.md.",
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/MarkerObservation"
      },
      "title": "Markers",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "notices": {
      "items": {
        "$ref": "#/$defs/NoticeCode"
      },
      "title": "Notices",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/QualityReport"
    },
    "request_id": {
      "description": "ULID. The only identifier that appears in server logs.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timings_ms": {
      "$ref": "#/$defs/Timings"
    }
  },
  "required": [
    "request_id",
    "decision",
    "quality",
    "confidence_band",
    "image",
    "model",
    "timings_ms"
  ],
  "title": "ScreeningResult",
  "type": "object",
  "x-contract-version": "1.0.0"
}
