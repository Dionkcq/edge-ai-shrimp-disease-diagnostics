{
  "$defs": {
    "ProblemCode": {
      "description": "Stable error codes for ``application/problem+json`` responses.",
      "enum": [
        "MALFORMED_REQUEST",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "UNDECODABLE_IMAGE",
        "SERVICE_BUSY",
        "NOT_FOUND",
        "INTERNAL_ERROR",
        "ADVICE_UNAVAILABLE"
      ],
      "title": "ProblemCode",
      "type": "string"
    }
  },
  "$id": "https://shrimp-screening.invalid/schemas/problem_detail.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "RFC 9457 problem document returned for every 4xx/5xx API response. Generated from backend/src/shrimp_screening/contracts/problem.py; do not hand-edit.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCode"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ULID of the request, for correlating with server logs.",
      "title": "Request Id"
    },
    "retry_after_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Present for SERVICE_BUSY; mirrors the Retry-After header.",
      "title": "Retry After Seconds"
    },
    "status": {
      "maximum": 599,
      "minimum": 400,
      "title": "Status",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "description": "Problem type URI reference, relative to the app origin.",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "code"
  ],
  "title": "ProblemDetail",
  "type": "object",
  "x-contract-version": "1.0.0"
}
