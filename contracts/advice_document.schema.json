{
  "$defs": {
    "CitedSource": {
      "additionalProperties": false,
      "description": "One reference behind a guidance item.",
      "properties": {
        "accessed_on": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Accessed On",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessed_on"
      ],
      "title": "CitedSource",
      "type": "object"
    },
    "Decision": {
      "description": "The complete set of screening outcomes. There is no sixth member, ever.\n\n``UNABLE_TO_ASSESS`` absorbs quality failure, model unavailability, low\nconfidence and inference failure. The *reason* lives in\n:class:`AbstentionReason` and :class:`QualityReason`, never in the decision,\nso that no caller can pattern-match a decision string into a health claim.",
      "enum": [
        "GILL_DARKENING_MARKER_DETECTED",
        "WHITE_SPOT_MARKER_DETECTED",
        "MULTIPLE_TARGET_MARKERS_DETECTED",
        "NO_TARGET_MARKER_DETECTED",
        "UNABLE_TO_ASSESS"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "$id": "https://shrimp-screening.invalid/schemas/advice_document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response body of GET /api/v1/advice/{decision}, an optional endpoint generated by a local Ollama model and disabled by default. Generated from backend/src/shrimp_screening/contracts/advice.py; do not hand-edit.",
  "properties": {
    "additional_considerations": {
      "items": {
        "type": "string"
      },
      "title": "Additional Considerations",
      "type": "array"
    },
    "based_on_guidance_id": {
      "minLength": 1,
      "title": "Based On Guidance Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "immediate_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Immediate Actions",
      "type": "array"
    },
    "limitations": {
      "description": "Identifiers defined in docs/LIMITATIONS.md that apply to this decision.",
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "prevention_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Prevention Actions",
      "type": "array"
    },
    "provider": {
      "const": "ollama",
      "default": "ollama",
      "title": "Provider",
      "type": "string"
    },
    "review_note": {
      "minLength": 1,
      "title": "Review Note",
      "type": "string"
    },
    "review_status": {
      "const": "AI_GENERATED_NOT_REVIEWED",
      "default": "AI_GENERATED_NOT_REVIEWED",
      "title": "Review Status",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CitedSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "summary",
    "immediate_actions",
    "prevention_actions",
    "based_on_guidance_id",
    "sources",
    "model_id",
    "review_note"
  ],
  "title": "AdviceDocument",
  "type": "object",
  "x-contract-version": "1.0.0"
}
